// PlayDrop desktop window. A thin client of playdropd: every screen reads a global that
// the Rust controller fills from the IPC, and every action is a callback into Rust.

import { TabWidget, Button, Palette } from "std-widgets.slint";
import { ConnPhase, HelpFocus } from "types.slint";
import { Nav, ConnState, NoticeState, InputState, DevicesState, PairingState, TransfersState, SettingsState, DiagnosticsState, HelpState, UpdateUi } from "globals.slint";
import { ConnectionScreen } from "connection.slint";
import { DevicesPage } from "devices.slint";
import { AddDevicePage } from "add-device.slint";
import { TransfersPage } from "transfers.slint";
import { SettingsPage } from "settings.slint";
import { DiagnosticsPage } from "diagnostics.slint";
import { PairingDialog, QrDialog } from "pairing.slint";
import { HelpDialog } from "help.slint";

export { ConnPhase, HelpFocus, Nav, ConnState, NoticeState, InputState, DevicesState, PairingState, TransfersState, SettingsState, DiagnosticsState, HelpState, UpdateUi }

component NoticeBar inherits Rectangle {
    background: NoticeState.error ? #c42b1c : Palette.accent-background;
    accessible-role: text;
    accessible-label: NoticeState.text;
    HorizontalLayout {
        padding: 8px;
        padding-left: 16px;
        spacing: 8px;
        Text {
            text: NoticeState.text;
            color: NoticeState.error ? #ffffff : Palette.accent-foreground;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        Button {
            text: "Dismiss";
            clicked => {
                NoticeState.dismiss();
            }
        }
    }
}

// Persistent while any remote input session is open (SR-25): who is in control, and the
// kill switch. Not dismissable; it goes away when the sessions end.
component InputBanner inherits Rectangle {
    background: #b25e00;
    accessible-role: text;
    accessible-label: InputState.banner;
    HorizontalLayout {
        padding: 8px;
        padding-left: 16px;
        spacing: 8px;
        Text {
            text: InputState.banner;
            color: #ffffff;
            font-weight: 600;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        Button {
            text: "Stop";
            primary: true;
            clicked => {
                InputState.stop();
            }
        }
    }
}

// A newer release, its download and install, or what went wrong (docs/ipc.md 1.9). Shown
// above every tab. Nothing is focused by default, so no key press starts an install.
component UpdateBanner inherits Rectangle {
    background: UpdateUi.banner-error ? #c42b1c : Palette.alternate-background;
    border-width: 1px;
    border-color: UpdateUi.banner-error ? #c42b1c : Palette.border;
    accessible-role: text;
    accessible-label: UpdateUi.banner-text;
    HorizontalLayout {
        padding: 8px;
        padding-left: 16px;
        spacing: 8px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: UpdateUi.banner-text;
                color: UpdateUi.banner-error ? #ffffff : Palette.foreground;
                font-weight: 600;
                wrap: word-wrap;
            }

            if UpdateUi.banner-detail != "": Text {
                text: UpdateUi.banner-detail;
                color: UpdateUi.banner-error ? #ffffff : Palette.foreground;
                opacity: 0.8;
                font-size: 12px;
                wrap: word-wrap;
            }

            if UpdateUi.show-link: Text {
                text: "What is new";
                color: UpdateUi.banner-error ? #ffffff : Palette.accent-background;
                font-size: 12px;
                accessible-role: button;
                accessible-label: "What is new: open the release page";
                accessible-action-default => {
                    UpdateUi.open-page();
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        UpdateUi.open-page();
                    }
                }
            }
        }

        if UpdateUi.primary-text != "": VerticalLayout {
            alignment: center;
            Button {
                text: UpdateUi.primary-text;
                clicked => {
                    UpdateUi.primary();
                }
            }
        }

        if UpdateUi.show-later: VerticalLayout {
            alignment: center;
            Button {
                text: "Later";
                clicked => {
                    UpdateUi.later();
                }
            }
        }
    }
}

export component App inherits Window {
    in property <image> app-icon;

    title: "PlayDrop";
    icon: root.app-icon;
    min-width: 480px;
    min-height: 360px;
    preferred-width: 720px;
    preferred-height: 600px;
    background: Palette.background;

    if ConnState.phase != ConnPhase.connected: ConnectionScreen { }

    if ConnState.phase == ConnPhase.connected: VerticalLayout {
        if InputState.banner != "": InputBanner { }

        if UpdateUi.banner-visible: UpdateBanner { }

        TabWidget {
            current-index <=> Nav.page;
            changed current-index => {
                if self.current-index == 4 {
                    DiagnosticsState.refresh();
                }
            }

            Tab {
                title: "Devices";
                DevicesPage { }
            }

            Tab {
                title: "Add device";
                AddDevicePage { }
            }

            Tab {
                title: TransfersState.pending-offers > 0 ? "Transfers (" + TransfersState.pending-offers + ")" : "Transfers";
                TransfersPage { }
            }

            Tab {
                title: "Settings";
                SettingsPage { }
            }

            Tab {
                title: "Diagnostics";
                DiagnosticsPage { }
            }
        }

        if NoticeState.text != "": NoticeBar { }
    }

    if HelpState.visible && ConnState.phase == ConnPhase.connected: HelpDialog { }

    if PairingState.prompt-visible: PairingDialog { }

    if PairingState.qr-visible: QrDialog { }
}
