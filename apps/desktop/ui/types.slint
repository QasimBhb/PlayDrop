// Data shapes the Rust side fills in. Rust builds them in `src/model.rs` from the IPC
// contract; the screens only display them.

// Where the window stands with the daemon.
export enum ConnPhase {
    connecting,
    not-running,
    failed,
    connected,
}

// Which way out the "Can't find your device?" panel puts first, from the Diagnose summary.
export enum HelpFocus {
    none,
    // Multicast is blocked: pair by QR code or by address.
    qr-or-address,
    // No interface on the device's network: phone hotspot or USB tether.
    hotspot-or-usb,
    // The host firewall blocks the port: run its command.
    firewall,
}

// One media player on a device, with the controls its state allows.
export struct MediaRow {
    // Player ID from the device, sent back with every command.
    player: string,
    title: string,
    // "Artist · Player · Playing".
    detail: string,
    playing: bool,
    can-previous: bool,
    can-next: bool,
    // The play/pause button's action in protocol.md 5.9 spelling ("playPause", "play" or
    // "pause"); empty when the player offers none, which hides the button.
    toggle-action: string,
    // Volume 0 to 100; `has-volume` false hides the slider.
    has-volume: bool,
    volume: int,
}

// One paired device on the Devices screen.
export struct DeviceRow {
    // Hex Device ID, used as the peer query for every request.
    id: string,
    label: string,
    // Shown beside the label so a renamed device stays recognisable (SR-8).
    short-id: string,
    // "Online", "Offline", "Asleep", "Idle" or "Locked".
    state: string,
    online: bool,
    // Empty when unknown.
    battery: string,
    paired: string,
    last-seen: string,
    // Last discovery problem, empty when none.
    note: string,
    grant-files: bool,
    grant-clipboard-in: bool,
    grant-clipboard-out: bool,
    grant-find: bool,
    grant-input: bool,
    grant-media: bool,
    // The device accepts remote input (an `input.*` capability). Not offered in v1: the
    // desktop does not control other devices yet.
    can-be-controlled: bool,
    // The device lists `media.control`: its players can be controlled from here.
    can-control-media: bool,
    // Now playing on the device (media state, protocol.md 5.9), one entry per player,
    // the playing ones first.
    players: [MediaRow],
}

// A device seen in its own "Add device" window.
export struct CandidateRow {
    name: string,
    device-type: string,
    addr: string,
}

// One transfer, either direction.
export struct TransferRow {
    id: string,
    receive: bool,
    title: string,
    files: string,
    // "offered", "active", "complete", "failed" or "cancelled".
    state: string,
    status-text: string,
    progress: float,
    show-progress: bool,
    detail: string,
    can-respond: bool,
    can-cancel: bool,
    can-open: bool,
    can-show: bool,
}

// One block of the Diagnostics screen.
export struct DiagSection {
    title: string,
    lines: [string],
    ok: bool,
}
