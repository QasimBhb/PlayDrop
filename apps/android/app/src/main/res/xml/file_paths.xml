<?xml version="1.0" encoding="utf-8"?>
<!-- FileProvider roots. Only two narrow folders are shareable: received files on Android 8
     and 9 (no MediaStore.Downloads there) and the single cached clipboard image. -->
<paths>
    <external-files-path name="downloads" path="Download/" />
    <files-path name="downloads_internal" path="downloads/" />
    <cache-path name="clipboard" path="clipboard/" />
</paths>
