    <!-- Can't find your computer -->
    <string name="ui_help_link">Can\'t find your computer?</string>
    <string name="ui_help_title">Can\'t find your computer?</string>
    <string name="ui_help_intro">Pick the line that matches your network. Nothing here needs an account or the internet.</string>
    <string name="ui_help_start_here">Start here</string>
    <string name="ui_help_same_title">Same network, but nothing shows up</string>
    <string name="ui_help_same_body">Mesh Wi-Fi, a VPN or a router that filters multicast can hide your computer even when both are on the same network. Pair without searching: show the QR code on one device and scan it on the other, or type the computer\'s address.</string>
    <string name="ui_help_same_action">Pair by QR or address</string>
    <string name="ui_help_hotspot_title">Guest, hotel or campus Wi-Fi</string>
    <string name="ui_help_hotspot_body">These networks often stop devices from reaching each other, and no app can get around that. Turn on this phone\'s hotspot and connect the computer to it. PlayDrop finds the computer within seconds.</string>
    <string name="ui_help_hotspot_action">Open hotspot settings</string>
    <string name="ui_help_usb_title">USB tethering, the fastest fallback</string>
    <string name="ui_help_usb_body">Plug the phone into the computer with a cable and turn on USB tethering. The computer gets a wired network to the phone, with no Wi-Fi in the way.</string>
    <string name="ui_help_usb_action">Open tethering settings</string>
    <string name="ui_help_vpn_title">Using a VPN</string>
    <string name="ui_help_vpn_body">Turn on local network access in the VPN app, or pause the VPN while you pair and send. Many VPNs block traffic to nearby devices.</string>
    <string name="ui_help_settings_missing">Could not open the settings screen. Open Settings, then Connections, then Mobile Hotspot and Tethering.</string>
    <string name="ui_diag_help_suggest_same">Both devices look to be on one network. Pairing by QR or address works without discovery.</string>
    <string name="ui_diag_help_suggest_other">The devices are on different networks. A hotspot or USB tethering puts them on one.</string>
    <string name="ui_diag_help_suggest_generic">Still stuck?</string>

    <!-- Onboarding -->
