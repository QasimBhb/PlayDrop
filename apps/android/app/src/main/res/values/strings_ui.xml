    <string name="ui_onboarding_2_title">Notifications</string>
    <string name="ui_onboarding_2_body">PlayDrop tells you when files arrive and when a device wants to pair. It also keeps one quiet notification while it runs, so Android lets it stay reachable.</string>
    <string name="ui_onboarding_3_title">Start PlayDrop</string>
    <string name="ui_onboarding_3_body">PlayDrop runs quietly in the background so your devices can reach this phone. Next, pair your computer from the Devices tab.</string>
